# Copy to backend/.env (or set in your host's secret manager). Never commit real values.
# Nothing here is ever sent to the browser.

# --- API server -------------------------------------------------------------
PORT=8787
HOST=0.0.0.0
# Comma-separated origins allowed to call the API: add your deployed frontend URL.
CORS_ORIGINS=https://localhost:8081,http://localhost:8081
# DATA_DIR=./api/data            # job table, scenes, masks (default api/data)
WORKER_INLINE=true               # false = run `npm run worker` as a separate process
JOB_MAX_ATTEMPTS=2
JOB_STALE_AFTER_MS=300000
LOG_LEVEL=info

# --- Meta Model API (primary AI provider) ------------------------------------
# Empty = offline mode: fixture data, every AI step labelled as not run.
MODEL_API_KEY=
META_BASE_URL=https://api.meta.ai/v1
MUSE_MODEL=muse-spark-1.3
MUSE_ESCALATION_ENABLED=false    # retry hard plans / run the review on Wonder
MUSE_ESCALATION_MODEL=muse-wonder-1.0
SAM_MODEL=sam-3.1
MUSE_IMAGE_MODEL=muse-image-1.0
REDESIGN_ENABLED=false           # Muse Image concept images
REDESIGN_MAX_PER_DAY=10
AI_TIMEOUT_MS=120000
AI_MAX_CALLS_PER_RUN=40          # hard cap per reconstruction run
SAM_MAX_IMAGES_PER_RUN=8
SAM_MAX_CONCEPTS_PER_IMAGE=4

# --- RealtyAPI (listing data) -------------------------------------------------
REALTYAPI_KEY=
REALTYAPI_PROVIDER=              # e.g. the provider subdomain; see docs/realtyapi.md

# --- SAM 3D Objects on Modal (optional, OFF) -----------------------------------
# Switch on only after licence, GPU and billing checks in docs/modal-sam3d.md.
SAM3D_PROVIDER=modal
SAM3D_ENABLED=false
SAM3D_GPU=L40S
SAM3D_MAX_CONCURRENCY=1
SAM3D_MAX_OBJECTS_PER_RUN=1
SAM3D_JOB_TIMEOUT_SECONDS=600
SAM3D_CACHE_ENABLED=true
SAM3D_REQUIRE_MANUAL_APPROVAL=true
MODAL_ENDPOINT_URL=              # https://<workspace>--walk-in-sam3d-sam3d-web.modal.run/reconstruct
MODAL_AUTH_SECRET=               # same value as the sam3d-auth Modal secret
# BAKE_OUT_DIR=../frontend/public/cached   # where `npm run bake` writes static scenes
